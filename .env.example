# Meta Threads API (Meta 앱에서 직접 발급)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
THREADS_API_BASE=https://graph.threads.net

# 선택: AI 문안 생성. 없으면 내장 문안으로도 작동합니다.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_QUALITY=gpt-5.6-sol

# Threads가 이미지를 가져갈 수 있는 공개 URL
# 방법 A: public/generated 폴더를 웹에 공개한 주소
PUBLIC_MEDIA_BASE_URL=

# 방법 B: 공개 GitHub 저장소를 이미지 저장소로 사용
GITHUB_MEDIA_TOKEN=
GITHUB_MEDIA_REPO=
GITHUB_MEDIA_BRANCH=main
GITHUB_MEDIA_PREFIX=malangpu/generated

# 운영 안전장치. 실제 게시 전 반드시 true로 변경
LIVE_PUBLISH_ENABLED=false
